# Copy this file to .env and fill it with development-only values.
NODE_ENV=development
PORT=8080
LOG_LEVEL=info

DATABASE_URL=

CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_PROXY_URL=
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PROXY_URL=
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

DEFAULT_OBJECT_STORAGE_BUCKET_ID=
PRIVATE_OBJECT_DIR=
PUBLIC_OBJECT_SEARCH_PATHS=

SESSION_SECRET=
INTERNAL_SECRET_TOKEN=
# Production only: dedicated capability for POST /api/internal/operator.
# Never put this in any VITE_ or EXPO_PUBLIC_ variable.
MARSA_OPERATOR_SECRET=

# Runtime business configuration
PAYMENT_GATEWAY=test
ENABLE_TEST_PAYMENT_GATEWAY=true
DEFAULT_MARKET_TIME_ZONE=Africa/Cairo
